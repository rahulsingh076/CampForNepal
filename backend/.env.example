# Copy to .env and adjust for your machine. Never commit .env.
#
#   cp .env.example .env
#
# Loaded by Node's built-in --env-file, so no dotenv package is involved.

# One of: development | test | production
NODE_ENV=development

PORT=5000

# Must start with "/". Every route is mounted beneath this.
API_PREFIX=/api/v1

# Local MongoDB. For Atlas use the SRV form:
#   mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/camp_for_nepal?retryWrites=true&w=majority
# This value is never logged and never returned in an API response.
MONGODB_URI=mongodb://127.0.0.1:27017/camp_for_nepal

# Comma-separated browser origin allowlist. No wildcards.
# 5173 is the Vite dev server the frontend runs on.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum accepted request body, in any format body-parser understands.
REQUEST_BODY_LIMIT=1mb

# How long a graceful shutdown may take before the process is forced down.
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------- Catalogue and seeds
# Where the frontend repository lives. Needed ONLY by the seed scripts; the
# Express server never reads the frontend and runs fine without this set.
FRONTEND_ROOT=../frontend

# Public list pagination. Default must not exceed the maximum.
PUBLIC_DEFAULT_PAGE_SIZE=12
PUBLIC_MAX_PAGE_SIZE=100

# Seeding a production database is refused unless this is explicitly true.
ALLOW_SEED_IN_PRODUCTION=false

# The reset script deletes migrated records. Refused unless explicitly true.
ALLOW_DESTRUCTIVE_SEED=false

# ---------------------------------------------------------------- Authentication and sessions
# Comma-separated for rotation: the FIRST signs new sessions, all of them can
# verify existing ones. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRETS=replace-with-a-random-secret-of-at-least-32-bytes
SESSION_COOKIE_NAME=cfn.sid
# Secure requires HTTPS, so it is off for local http. Production forces it on
# whatever this says. SameSite=lax blocks cross-site form posts.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_IDLE_TIMEOUT_MS=1800000
SESSION_ABSOLUTE_TIMEOUT_MS=28800000
SESSION_TOUCH_AFTER_SECONDS=60

AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_ACCOUNT_LOCK_THRESHOLD=5
AUTH_ACCOUNT_LOCK_MS=900000

# Number of proxies in front of this API. 0 means none — never blanket-trust.
TRUST_PROXY_HOPS=0

# The authentication tests connect to MONGODB_URI's host but swap the database
# name for this one, so they can never touch the development catalogue. The
# name must end in _test.
AUTH_TEST_DATABASE_NAME=camp_for_nepal_auth_test

# One-time super-admin creation. Turn back off immediately afterwards.
ALLOW_BOOTSTRAP_SUPER_ADMIN=false
BOOTSTRAP_SUPER_ADMIN_NAME=
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# ---------------------------------------------------------------- Inquiries
# Public inquiry submission limits, per client address.
INQUIRY_PUBLIC_WINDOW_MS=900000
INQUIRY_PUBLIC_MAX_SUBMISSIONS=10

# Prefix for the public reference code, e.g. CFN-2026-7K9Q2M.
# Uppercase letters and digits only.
INQUIRY_REFERENCE_PREFIX=CFN

INQUIRY_MAX_MESSAGE_LENGTH=5000
INQUIRY_MAX_NOTE_LENGTH=3000
INQUIRY_MAX_PEOPLE=100

# Must match the hidden field the frontend renders. HoneypotField.jsx currently
# names it "company-website" — not "website".
INQUIRY_HONEYPOT_FIELD=company-website

# A weak signal only. A fast submission is never rejected on its own; see
# docs/INQUIRY_API.md. Matches MINIMUM_FILL_MS in the frontend's useForm hook.
INQUIRY_MIN_FILL_TIME_MS=3000

# OWNER DECISION REQUIRED. Stored against every consent record, so it must be a
# real, published policy version before launch. Development runs with the
# placeholder; production readiness does not.
PRIVACY_POLICY_VERSION=owner-required

# The inquiry tests connect to MONGODB_URI's host but swap the database name
# for this one. Must end in _test.
INQUIRY_TEST_DATABASE_NAME=camp_for_nepal_inquiry_test
